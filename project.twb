      <column caption='Average Delivery Time' datatype='real' name='[Calculation_0642435807825921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    FLOOR(&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;second&apos;,&#13;&#10;            [order_purchase_timestamp],&#13;&#10;            [order_delivered_customer_date]&#13;&#10;        ) / 86400.0&#13;&#10;    )&#13;&#10;)' />
